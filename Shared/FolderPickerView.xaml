<UserControl x:Class="FullscreenKit.FolderPickerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True" FocusVisualStyle="{x:Null}">
    <UserControl.Resources>
        <SolidColorBrush x:Key="PickerBg" Color="#FF14181C"/>
        <SolidColorBrush x:Key="PickerAccent" Color="#FF2F7DD1"/>
        <Style x:Key="PickerRow" TargetType="ListBoxItem">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsHitTestVisible" Value="{Binding Selectable}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Margin="0,2" Padding="16,10" CornerRadius="8" Background="Transparent">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource PickerAccent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource PickerBg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- header: title + path, current mode on the right -->
        <Grid Grid.Row="0" Margin="48,32,48,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock x:Name="TitleText" FontSize="32" FontWeight="SemiBold" Foreground="White"/>
                <TextBlock x:Name="PathText" FontSize="16" Foreground="#FFA0A8B0" Margin="0,6,0,0"
                           TextTrimming="CharacterEllipsis"/>
            </StackPanel>
            <Border x:Name="ModeBadge" Grid.Column="1" CornerRadius="16" Padding="18,6" Margin="16,4,0,0"
                    VerticalAlignment="Top" Background="#FF2F7DD1" Visibility="Collapsed">
                <TextBlock x:Name="ModeText" FontSize="16" FontWeight="Bold" Foreground="White"/>
            </Border>
        </Grid>

        <ListBox x:Name="List" Grid.Row="1" Margin="40,0,40,0"
                 Background="Transparent" BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ItemContainerStyle="{StaticResource PickerRow}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="48"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="26"
                                   Foreground="White" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Text}" FontSize="{Binding TextSize}"
                                       Foreground="{Binding TextBrush}" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding Sub}" FontSize="14" Foreground="#FFB8C0C8"
                                       TextTrimming="CharacterEllipsis" Visibility="{Binding SubVisibility}"/>
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="26"
                                   Foreground="#FF7CE38B" VerticalAlignment="Center" Margin="12,0,4,0"
                                   Visibility="{Binding MarkVisibility}"/>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- background move progress (collapsed when nothing is running) -->
        <Border x:Name="ProgressPanel" Grid.Row="2" Margin="48,10,48,0" Padding="16,10" CornerRadius="8"
                Background="#FF1E252B" Visibility="Collapsed">
            <StackPanel>
                <TextBlock x:Name="ProgressText" FontSize="16" Foreground="White" TextTrimming="CharacterEllipsis"/>
                <ProgressBar x:Name="MoveBar" Height="10" Margin="0,8,0,0" Minimum="0" Maximum="100"
                             BorderThickness="0" Background="#FF2A3138" Foreground="#FFF2A33A"/>
            </StackPanel>
        </Border>

        <!-- button prompts: change with the current mode -->
        <WrapPanel x:Name="HintPanel" Grid.Row="3" Margin="48,12,48,28"/>
    </Grid>
</UserControl>
