<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net462</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>QuickAdd</AssemblyName>
    <RootNamespace>QuickAdd</RootNamespace>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <!-- 6.12.0 = first SDK with OnControllerButtonStateChanged + CreateWindow working in Fullscreen -->
    <PackageReference Include="PlayniteSDK" Version="6.12.0" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Runtime.Serialization" />
  </ItemGroup>
  <ItemGroup>
    <!-- copy the extension manifest and the icon next to QuickAdd.dll (SDK projects don't do it by themselves) -->
    <None Update="extension.yaml" CopyToOutputDirectory="PreserveNewest" />
    <None Update="icon.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <!-- if the files of the alternative layout are still in the repository, ignore them -->
    <Compile Remove="src\**" />
    <Page Remove="src\**" />
    <!-- removed in this version: the Scan mode. Old copies are ignored if they are still in the repository -->
    <Compile Remove="Shared\ScanManager.cs" />
    <Compile Remove="Shared\ScanSettings.cs" />
    <Compile Remove="Shared\NameCleaner.cs" />
    <Compile Remove="Shared\FolderPickerView.Scan.cs" />
    <!-- removed in this version: the metadata download -->
    <Compile Remove="Shared\MetadataFetcher.cs" />
    <Compile Remove="Shared\MetadataManager.cs" />
  </ItemGroup>
</Project>
