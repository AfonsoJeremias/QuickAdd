<UserControl x:Class="QuickAdd.UI.PickerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True" FocusVisualStyle="{x:Null}">
    <UserControl.Resources>
        <SolidColorBrush x:Key="Bg" Color="#FF14181C"/>
        <SolidColorBrush x:Key="Accent" Color="#FF2F7DD1"/>
        <SolidColorBrush x:Key="Muted" Color="#FFA0A8B0"/>
        <SolidColorBrush x:Key="Card" Color="#FF1E252B"/>
        <SolidColorBrush x:Key="KeyCap" Color="#FF2A3138"/>

        <Style x:Key="RowStyle" TargetType="ListBoxItem">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsHitTestVisible" Value="{Binding IsSelectable}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Margin="0,2" Padding="16,10" CornerRadius="8" Background="Transparent">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="RowTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="48"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="26" Foreground="White" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Text}" FontSize="{Binding TextSize}" Foreground="{Binding TextBrush}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Sub}" FontSize="14" Foreground="#FFB8C0C8" TextTrimming="CharacterEllipsis" Visibility="{Binding SubVisibility}"/>
                </StackPanel>
                <TextBlock Grid.Column="2" Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="26" Foreground="#FF7CE38B"
                           VerticalAlignment="Center" Margin="12,0,4,0" Visibility="{Binding MarkVisibility}"/>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="TabTemplate">
            <Border Background="{Binding Background}" CornerRadius="16" Padding="16,6" Margin="3,0">
                <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="Bold" Foreground="{Binding Foreground}"/>
            </Border>
        </DataTemplate>

        <!-- fixed-width key column: every label lines up -->
        <DataTemplate x:Key="HintTemplate">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <Grid Width="80">
                    <Border Width="30" Height="30" CornerRadius="15" Background="{Binding FaceBrush}"
                            HorizontalAlignment="Center" Visibility="{Binding FaceVisibility}">
                        <TextBlock Text="{Binding Key}" FontWeight="Bold" FontSize="15" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <Border MinWidth="62" Height="28" CornerRadius="7" Background="{StaticResource KeyCap}" Padding="10,0"
                            HorizontalAlignment="Center" Visibility="{Binding PillVisibility}">
                        <TextBlock Text="{Binding Key}" FontWeight="Bold" FontSize="14" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
                <TextBlock Text="{Binding Label}" FontSize="16" Foreground="{StaticResource Muted}"
                           VerticalAlignment="Center" Margin="8,0,16,0"/>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Background="{StaticResource Bg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="48,32,48,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="{Binding Title}" FontSize="32" FontWeight="SemiBold" Foreground="White" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding Subtitle}" FontSize="16" Foreground="{StaticResource Muted}" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="16,4,0,0"
                        Visibility="{Binding TabsVisibility}">
                <TextBlock Text="◀" FontSize="16" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="6,0"/>
                <ItemsControl ItemsSource="{Binding Tabs}" ItemTemplate="{StaticResource TabTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
                <TextBlock Text="▶" FontSize="16" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="6,0"/>
            </StackPanel>
        </Grid>

        <ListBox x:Name="List" Grid.Row="1" Margin="40,0" Background="Transparent" BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ItemsSource="{Binding Rows}" SelectedIndex="{Binding SelectedIndex, Mode=TwoWay}"
                 ItemContainerStyle="{StaticResource RowStyle}" ItemTemplate="{StaticResource RowTemplate}"/>

        <StackPanel Grid.Row="2" Margin="48,10,48,0">
            <Border Padding="16,10" CornerRadius="8" Background="{StaticResource Card}" Visibility="{Binding MoveJob.Visibility}">
                <StackPanel>
                    <TextBlock Text="{Binding MoveJob.Text}" FontSize="16" Foreground="White" TextTrimming="CharacterEllipsis"/>
                    <ProgressBar Height="10" Margin="0,8,0,0" Minimum="0" Maximum="100" BorderThickness="0"
                                 Background="{StaticResource KeyCap}" Foreground="#FFF2A33A"
                                 Value="{Binding MoveJob.Percent, Mode=OneWay}" Visibility="{Binding MoveJob.BarVisibility}"/>
                </StackPanel>
            </Border>
            <Border Padding="16,10" CornerRadius="8" Background="{StaticResource Card}" Margin="0,8,0,0" Visibility="{Binding ScanJob.Visibility}">
                <StackPanel>
                    <TextBlock Text="{Binding ScanJob.Text}" FontSize="16" Foreground="White" TextTrimming="CharacterEllipsis"/>
                    <ProgressBar Height="10" Margin="0,8,0,0" Minimum="0" Maximum="100" BorderThickness="0"
                                 Background="{StaticResource KeyCap}" Foreground="#FF2FA36B"
                                 Value="{Binding ScanJob.Percent, Mode=OneWay}"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <ItemsControl Grid.Row="3" Margin="48,12,48,24" ItemsSource="{Binding Hints}" ItemTemplate="{StaticResource HintTemplate}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><UniformGrid Columns="4"/></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
        </ItemsControl>
    </Grid>
</UserControl>
